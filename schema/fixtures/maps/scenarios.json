{
  "version": 1,
  "name": "scenarios-fixture",
  "nodes": [
    { "id": "web", "kind": "context" },
    { "id": "server", "kind": "context" },
    { "id": "store", "kind": "external" }
  ],
  "seams": [
    {
      "id": "web-server",
      "from": "web",
      "to": "server",
      "owner": "server",
      "flows": [
        { "kind": "data", "from": "server", "to": "web", "carries": "Overview" },
        { "kind": "data", "from": "web", "to": "server", "carries": "PinRequest" },
        { "kind": "control", "from": "server", "to": "web", "carries": "WebEvent Changed" },
        { "kind": "control", "from": "server", "to": "web", "carries": "Reload" }
      ]
    },
    {
      "id": "server-store",
      "from": "server",
      "to": "store",
      "owner": "server",
      "flows": [
        { "kind": "data", "from": "server", "to": "store", "carries": "rows" },
        { "kind": "data", "from": "store", "to": "server", "carries": "rows" }
      ]
    }
  ],
  "scenarios": [
    {
      "id": "pin-an-issue",
      "name": "Pin an issue",
      "description": "A person drops an issue on a part and every browser sees it.",
      "steps": [
        { "seam": "web-server", "from": "web", "to": "server", "kind": "data", "says": "the browser sends the pin" },
        { "seam": "server-store", "from": "server", "to": "store", "kind": "data" },
        { "seam": "web-server", "from": "server", "to": "web", "kind": "control", "carries": "WebEvent Changed", "says": "every browser is told something changed" },
        { "seam": "web-server", "from": "server", "to": "web", "kind": "data" }
      ]
    },
    {
      "id": "read-back",
      "name": "Read back",
      "steps": [
        { "seam": "server-store", "from": "store", "to": "server", "kind": "data" }
      ]
    }
  ]
}
