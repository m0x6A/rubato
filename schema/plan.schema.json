{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plan",
  "type": "object",
  "properties": {
    "affected_parts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AffectedPart"
      }
    },
    "assumed": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Assumption"
      }
    },
    "attempt_limit": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "data_models": {
      "description": "The tables, types, schemas, events and files the change introduces, changes or removes,\nfrom its `## Data models` table (ADR 0031). Optional; empty when absent or \"None.\"",
      "type": "array",
      "items": {
        "$ref": "#/$defs/DataModel"
      }
    },
    "flows": {
      "description": "What the plan will send across seams, from its `## Flows` table (ADR 0021). Optional.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/PlanFlow"
      }
    },
    "git_ref": {
      "description": "Git ref the plan was read from (branch name or commit sha).",
      "type": [
        "string",
        "null"
      ]
    },
    "issue": {
      "$ref": "#/$defs/IssueRef"
    },
    "o_rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ORow"
      }
    },
    "path": {
      "description": "Path of the plan file inside the repository.",
      "type": "string"
    },
    "spend_cap_usd": {
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "issue",
    "path",
    "affected_parts"
  ],
  "$defs": {
    "AffectedPart": {
      "description": "One row of the affected-parts table. This is what paints the map.",
      "type": "object",
      "properties": {
        "change": {
          "description": "What changes, in one line.",
          "type": "string"
        },
        "node": {
          "description": "Node id from the map.",
          "type": "string"
        },
        "seams": {
          "description": "Seam ids this change touches. Each needs an O-row.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "$ref": "#/$defs/PartStatus"
        }
      },
      "required": [
        "node",
        "status",
        "change"
      ]
    },
    "Assumption": {
      "description": "A decision the plan had to make that nothing settled.",
      "type": "object",
      "properties": {
        "alternatives": {
          "type": [
            "string",
            "null"
          ]
        },
        "chosen": {
          "type": "string"
        },
        "decision": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/AssumptionScope"
        }
      },
      "required": [
        "id",
        "decision",
        "chosen",
        "scope"
      ]
    },
    "AssumptionScope": {
      "oneOf": [
        {
          "description": "Inside one node: assumed and labelled.",
          "type": "string",
          "const": "node"
        },
        {
          "description": "On a seam: blocks until a human answers.",
          "type": "string",
          "const": "seam"
        }
      ]
    },
    "DataModel": {
      "description": "One row of the plan's Data models table (ADR 0031): a model on the part that owns it, and the\nseam it travels over, if any.",
      "type": "object",
      "properties": {
        "change": {
          "$ref": "#/$defs/ModelChange"
        },
        "crosses": {
          "description": "Seam id the model crosses. Must be touched in Affected parts.",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/DataModelKind"
        },
        "model": {
          "description": "The model's name or names, as written, backticks removed.",
          "type": "string"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "part": {
          "description": "Node id of the part that owns the model. Must be in Affected parts.",
          "type": "string"
        }
      },
      "required": [
        "model",
        "kind",
        "part",
        "change"
      ]
    },
    "DataModelKind": {
      "type": "string",
      "enum": [
        "table",
        "type",
        "schema",
        "event",
        "file"
      ]
    },
    "FlowKind": {
      "description": "Data moves; control tells the other side to do something.",
      "type": "string",
      "enum": [
        "data",
        "control"
      ]
    },
    "IssueRef": {
      "description": "A GitHub issue, addressed as `owner/name#number`.",
      "type": "object",
      "properties": {
        "number": {
          "description": "Issue number within the repository.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "repo": {
          "description": "Repository in `owner/name` form.",
          "type": "string"
        }
      },
      "required": [
        "repo",
        "number"
      ]
    },
    "ModelChange": {
      "type": "string",
      "enum": [
        "new",
        "changed",
        "removed"
      ]
    },
    "ORow": {
      "description": "The 3 am question for one seam: which signal leads back to it, where, and who is woken.",
      "type": "object",
      "properties": {
        "breaks_like": {
          "type": [
            "string",
            "null"
          ]
        },
        "owner": {
          "description": "Node id of the side that owns the fix.",
          "type": "string"
        },
        "panel": {
          "description": "Dashboard panel the signal appears on.",
          "type": "string"
        },
        "seam": {
          "type": "string"
        },
        "signal": {
          "description": "Span, metric or log line, with the `rubato.*` attributes it carries.",
          "type": "string"
        }
      },
      "required": [
        "seam",
        "signal",
        "panel",
        "owner"
      ]
    },
    "PartStatus": {
      "type": "string",
      "enum": [
        "affected",
        "new",
        "quiet"
      ]
    },
    "PlanFlow": {
      "description": "One row of the plan's Flows table: something the change sends from one part to another over\na seam. The seam must join the two parts.",
      "type": "object",
      "properties": {
        "carries": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/FlowKind"
        },
        "seam": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      },
      "required": [
        "from",
        "to",
        "seam",
        "kind",
        "carries"
      ]
    }
  }
}
