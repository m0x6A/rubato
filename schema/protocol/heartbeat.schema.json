{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Heartbeat",
  "description": "The companion's liveness signal.",
  "type": "object",
  "properties": {
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "claude_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "companion_id": {
      "type": "string",
      "format": "uuid"
    },
    "companion_version": {
      "type": "string"
    },
    "hostname": {
      "type": "string"
    },
    "tmux_ide_version": {
      "description": "Deprecated (ADR 0070): `tmux-ide --version` from a companion that still ran tmux-ide.\nRead, never sent by a current companion.",
      "type": [
        "string",
        "null"
      ]
    },
    "tmux_version": {
      "description": "`tmux -V` at start, such as `3.8` (ADR 0070). None on a headless companion (ADR 0062).",
      "type": [
        "string",
        "null"
      ]
    },
    "user": {
      "type": "string"
    }
  },
  "required": [
    "companion_id",
    "user",
    "at",
    "hostname",
    "companion_version"
  ]
}
