{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CallInResponse",
  "description": "What a call-in did.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "agent": {
          "$ref": "#/$defs/RoomAgent"
        },
        "outcome": {
          "type": "string",
          "const": "joined"
        }
      },
      "required": [
        "outcome",
        "agent"
      ]
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "type": "string",
          "const": "requested"
        },
        "request": {
          "$ref": "#/$defs/RoomRequest"
        }
      },
      "required": [
        "outcome",
        "request"
      ]
    }
  ],
  "$defs": {
    "LeftReason": {
      "description": "Why an agent left a room.",
      "oneOf": [
        {
          "description": "Its owner, or whoever called it in, dismissed it.",
          "type": "string",
          "const": "dismissed"
        },
        {
          "description": "Not addressed for `Limits.room_agent_idle_secs`.",
          "type": "string",
          "const": "timed_out"
        },
        {
          "description": "Its session ended.",
          "type": "string",
          "const": "session_ended"
        }
      ]
    },
    "RequestState": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "declined",
        "withdrawn"
      ]
    },
    "RoomAgent": {
      "description": "An agent called into a room (ADR 0057): who is in, called by whom, since when.",
      "type": "object",
      "properties": {
        "called_by": {
          "type": "string"
        },
        "handle": {
          "description": "`<owner>-agent`, what a message names to address it.",
          "type": "string"
        },
        "joined_at": {
          "type": "string",
          "format": "date-time"
        },
        "last_turn_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "launch_id": {
          "type": "string",
          "format": "uuid"
        },
        "left_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "left_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/LeftReason"
            },
            {
              "type": "null"
            }
          ]
        },
        "owner": {
          "type": "string"
        }
      },
      "required": [
        "handle",
        "owner",
        "launch_id",
        "called_by",
        "joined_at"
      ]
    },
    "RoomRequest": {
      "description": "A teammate's request to call someone else's agent in, pending until the owner answers.",
      "type": "object",
      "properties": {
        "answered_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "launch_id": {
          "type": "string",
          "format": "uuid"
        },
        "owner": {
          "type": "string"
        },
        "requested_by": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/RequestState"
        }
      },
      "required": [
        "id",
        "owner",
        "launch_id",
        "requested_by",
        "at",
        "state"
      ]
    }
  }
}
