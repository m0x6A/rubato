{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LaunchResult",
  "description": "Companion → server: what happened to a launch command.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "command_id": {
          "type": "string",
          "format": "uuid"
        },
        "draft_restored": {
          "description": "The command's `draft` was written into the new worktree (ADR 0053).",
          "type": "boolean"
        },
        "outcome": {
          "type": "string",
          "const": "started"
        },
        "restore_skipped": {
          "description": "Why the command's `draft` was not written, when it was not.",
          "anyOf": [
            {
              "$ref": "#/$defs/RestoreSkipped"
            },
            {
              "type": "null"
            }
          ]
        },
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "tmux_session": {
          "type": "string"
        },
        "worktree": {
          "type": "string"
        }
      },
      "required": [
        "outcome",
        "command_id",
        "session_id",
        "worktree",
        "tmux_session",
        "at"
      ]
    },
    {
      "type": "object",
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "command_id": {
          "type": "string",
          "format": "uuid"
        },
        "detail": {
          "type": "string"
        },
        "outcome": {
          "type": "string",
          "const": "refused"
        },
        "reason": {
          "$ref": "#/$defs/RefusalReason"
        }
      },
      "required": [
        "outcome",
        "command_id",
        "reason",
        "detail",
        "at"
      ]
    },
    {
      "type": "object",
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "command_id": {
          "type": "string",
          "format": "uuid"
        },
        "error": {
          "type": "string"
        },
        "outcome": {
          "type": "string",
          "const": "failed"
        }
      },
      "required": [
        "outcome",
        "command_id",
        "error",
        "at"
      ]
    }
  ],
  "$defs": {
    "RefusalReason": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "attempt_limit_reached"
          ]
        },
        {
          "description": "The command's user is not this companion's paired user.",
          "type": "string",
          "const": "not_paired_user"
        },
        {
          "description": "A session for this issue is already running on this machine.",
          "type": "string",
          "const": "already_running"
        },
        {
          "description": "tmux or claude missing or below the pinned version.",
          "type": "string",
          "const": "missing_dependency"
        }
      ]
    },
    "RestoreSkipped": {
      "description": "Why a companion did not write a launch's draft (ADR 0053, plan 122 §D5).",
      "oneOf": [
        {
          "description": "The launch reused a worktree whose files differ from the draft: they are left alone.",
          "type": "string",
          "const": "worktree_differs"
        },
        {
          "description": "A path is absolute or leaves the worktree: nothing was written.",
          "type": "string",
          "const": "path_outside"
        }
      ]
    }
  }
}
