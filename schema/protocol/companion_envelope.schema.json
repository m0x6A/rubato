{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CompanionEnvelope",
  "type": "object",
  "properties": {
    "message": {
      "$ref": "#/$defs/CompanionMessage"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "seq": {
      "description": "Monotonic per companion, starting at 1, persisted across restarts.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    }
  },
  "required": [
    "seq",
    "sent_at",
    "message"
  ],
  "$defs": {
    "AgentReport": {
      "description": "What a launched session's agent said it is doing, through `report_status` (ADR 0071). A\nsignal with its own time, never a progress state: the server shows the newest per launch and\nnever derives progress from it.",
      "type": "object",
      "properties": {
        "at": {
          "description": "When the agent called `report_status`.",
          "type": "string",
          "format": "date-time"
        },
        "doing": {
          "description": "One line, at most 200 characters (`limits::AGENT_DOING_MAX_CHARS`).",
          "type": "string",
          "maxLength": 200
        },
        "launch_id": {
          "description": "The launch the companion resolved from the call's `X-Rubato-Launch`, never from what the\nagent said.",
          "type": "string",
          "format": "uuid"
        },
        "parts": {
          "description": "Map ids the agent says it is on, at most 8 (`limits::AGENT_PARTS_MAX`).",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
          },
          "maxItems": 8
        }
      },
      "required": [
        "launch_id",
        "doing",
        "at"
      ]
    },
    "BlockCause": {
      "description": "Which hook blocked a session (ADR 0043): the current cause of the current status, set with\na *blocked* status and cleared by the next hook that implies a status.",
      "oneOf": [
        {
          "description": "`Notification` with `permission_prompt`: waiting for a permission, mid-turn.",
          "type": "string",
          "const": "permission_prompt"
        },
        {
          "description": "`Notification` with `idle_prompt`: waiting for input after the turn ended.",
          "type": "string",
          "const": "idle_prompt"
        },
        {
          "description": "`StopFailure`: the turn failed, mid-turn.",
          "type": "string",
          "const": "stop_failure"
        }
      ]
    },
    "CapHit": {
      "description": "A cap was hit. An event, not a log line; the issue becomes *Blocked*.",
      "type": "object",
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "issue": {
          "$ref": "#/$defs/IssueRef"
        },
        "kind": {
          "$ref": "#/$defs/CapKind"
        },
        "limit": {
          "type": "number",
          "format": "double"
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "issue",
        "kind",
        "value",
        "limit",
        "at"
      ]
    },
    "CapKind": {
      "type": "string",
      "enum": [
        "spend",
        "attempts"
      ]
    },
    "ClientKind": {
      "description": "What kind of client a companion is (ADR 0062). Every client has one owner and never approves.",
      "oneOf": [
        {
          "description": "Sessions in the developer's tmux, input pasted into the pane.",
          "type": "string",
          "const": "interactive"
        },
        {
          "description": "No terminal: each turn is a `claude -p` child process the companion holds.",
          "type": "string",
          "const": "headless"
        }
      ]
    },
    "CompanionMessage": {
      "description": "Companion → server.",
      "oneOf": [
        {
          "description": "First message after connect. Carries the pairing identity and where to resume from.",
          "type": "object",
          "properties": {
            "capabilities": {
              "description": "What this companion can take (`capability`). Absent from an older companion.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "client": {
              "description": "Interactive (tmux) or headless (ADR 0062). An older companion is interactive.",
              "$ref": "#/$defs/ClientKind"
            },
            "companion_id": {
              "type": "string",
              "format": "uuid"
            },
            "companion_version": {
              "type": "string"
            },
            "last_seen_server_seq": {
              "description": "Last server sequence the companion has seen; the server replays newer commands.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "protocol_version": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "hello"
            },
            "user": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "companion_id",
            "user",
            "companion_version",
            "protocol_version",
            "last_seen_server_seq"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "heartbeat"
            }
          },
          "$ref": "#/$defs/Heartbeat",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "hook"
            }
          },
          "$ref": "#/$defs/HookEvent",
          "required": [
            "type"
          ]
        },
        {
          "description": "Full snapshot of the sessions this companion sees. Replaces the previous snapshot.",
          "type": "object",
          "properties": {
            "sessions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SessionState"
              }
            },
            "type": {
              "type": "string",
              "const": "sessions"
            }
          },
          "required": [
            "type",
            "sessions"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "launch"
            }
          },
          "$ref": "#/$defs/LaunchResult",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "cap_hit"
            }
          },
          "$ref": "#/$defs/CapHit",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "stale"
            }
          },
          "$ref": "#/$defs/StaleSession",
          "required": [
            "type"
          ]
        },
        {
          "description": "The answer to one `SessionMessage` (ADR 0051).",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "session_message_result"
            }
          },
          "$ref": "#/$defs/SessionMessageResult",
          "required": [
            "type"
          ]
        },
        {
          "description": "A launched session's plan bundle at a settle point (ADR 0053).",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "draft"
            }
          },
          "$ref": "#/$defs/DraftBundle",
          "required": [
            "type"
          ]
        },
        {
          "description": "What `plan.ts handoff` reported to the loopback endpoint (ADR 0055).",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "handoff_report"
            }
          },
          "$ref": "#/$defs/HandoffReport",
          "required": [
            "type"
          ]
        },
        {
          "description": "An agent's answer to a room turn (ADR 0057).",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "room_reply"
            }
          },
          "$ref": "#/$defs/RoomReply",
          "required": [
            "type"
          ]
        },
        {
          "description": "What a launched session's agent said it is doing, through MCP (ADR 0071). Sent only to a\nserver that announced `agent_mcp`.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "agent_report"
            }
          },
          "$ref": "#/$defs/AgentReport",
          "required": [
            "type"
          ]
        },
        {
          "description": "Acknowledges a server envelope by sequence.",
          "type": "object",
          "properties": {
            "seq": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "ack"
            }
          },
          "required": [
            "type",
            "seq"
          ]
        }
      ]
    },
    "DraftBundle": {
      "description": "Companion → server: the plan bundle of one launched session at a settle point (`Stop`,\n`idle_prompt`, `SessionEnd`), sent only when its hash changed.",
      "type": "object",
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "branch": {
          "type": "string"
        },
        "bundle_hash": {
          "description": "`plan_hash::bundle_hash` of `files` (empty when refused).",
          "type": "string"
        },
        "files": {
          "description": "The plan first, then the rest of the bundle that exists in the worktree.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/DraftFile"
          }
        },
        "issue": {
          "$ref": "#/$defs/IssueRef"
        },
        "launch_id": {
          "type": "string",
          "format": "uuid"
        },
        "missing": {
          "description": "Bundle paths the plan names that are not in the worktree.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "refused": {
          "anyOf": [
            {
              "$ref": "#/$defs/DraftRefusal"
            },
            {
              "type": "null"
            }
          ]
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "launch_id",
        "issue",
        "branch",
        "files",
        "bundle_hash",
        "at"
      ]
    },
    "DraftFile": {
      "description": "One file of a bundle, as it is in the worktree.",
      "type": "object",
      "properties": {
        "path": {
          "description": "Repository path, as `bundle_paths` gives it.",
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "text"
      ]
    },
    "DraftRefusal": {
      "description": "Why a bundle was sent without its files.",
      "oneOf": [
        {
          "description": "The files together are larger than `Limits.draft_max_bytes`.",
          "type": "string",
          "const": "too_large"
        }
      ]
    },
    "HandoffOutcome": {
      "description": "What `plan.ts handoff` did.",
      "oneOf": [
        {
          "description": "One commit with the approval record and the accepted ADRs, pushed.",
          "type": "string",
          "const": "committed"
        },
        {
          "description": "The plan no longer hashes to the approved sha: nothing was written.",
          "type": "string",
          "const": "plan_changed"
        },
        {
          "description": "The bundle no longer hashes to the approved bundle: nothing was written.",
          "type": "string",
          "const": "bundle_changed"
        },
        {
          "description": "A pinned ADR changed after it was pinned: nothing was written.",
          "type": "string",
          "const": "adr_changed"
        },
        {
          "description": "Committed, but the push failed; a rerun pushes the same commit.",
          "type": "string",
          "const": "push_failed"
        },
        {
          "description": "Anything else, with the line's `error`.",
          "type": "string",
          "const": "error"
        }
      ]
    },
    "HandoffReport": {
      "description": "Companion → server: a handoff's outcome, for one launch.",
      "type": "object",
      "properties": {
        "adrs_accepted": {
          "description": "ADR numbers moved to accepted in this commit.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "adrs_left": {
          "description": "ADR numbers the approval covers that this repo could not accept (they live in the map\nrepo; finding `AdrsNotAccepted`).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "approval": {
          "description": "The Rubato approval id the handoff was run for.",
          "type": "string",
          "format": "uuid"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "commit": {
          "description": "The commit made, when one was.",
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "event": {
          "description": "Always `rubato.plan.handoff`.",
          "type": "string"
        },
        "launch_id": {
          "type": "string",
          "format": "uuid"
        },
        "outcome": {
          "$ref": "#/$defs/HandoffOutcome"
        }
      },
      "required": [
        "launch_id",
        "event",
        "outcome",
        "approval",
        "at"
      ]
    },
    "Heartbeat": {
      "description": "The companion's liveness signal.",
      "type": "object",
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "claude_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "companion_id": {
          "type": "string",
          "format": "uuid"
        },
        "companion_version": {
          "type": "string"
        },
        "hostname": {
          "type": "string"
        },
        "tmux_ide_version": {
          "description": "Deprecated (ADR 0070): `tmux-ide --version` from a companion that still ran tmux-ide.\nRead, never sent by a current companion.",
          "type": [
            "string",
            "null"
          ]
        },
        "tmux_version": {
          "description": "`tmux -V` at start, such as `3.8` (ADR 0070). None on a headless companion (ADR 0062).",
          "type": [
            "string",
            "null"
          ]
        },
        "user": {
          "type": "string"
        }
      },
      "required": [
        "companion_id",
        "user",
        "at",
        "hostname",
        "companion_version"
      ]
    },
    "HookEvent": {
      "description": "One hook invocation. Common stdin fields are lifted; the full payload travels in `payload`.",
      "type": "object",
      "properties": {
        "cwd": {
          "description": "`cwd` from the payload: the worktree, not the original project dir.",
          "type": "string"
        },
        "hook_event_name": {
          "$ref": "#/$defs/HookEventKind"
        },
        "launch_id": {
          "description": "The launch the hook came from, from the `X-Rubato-Launch` header the launched session's\nhook command sends (plan 122 §D1). Keeps a launch across a `/clear` that changes the\nsession id. Absent for a session not launched from Rubato and from an older companion.",
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "message_id": {
          "description": "On `UserPromptSubmit`: the session message this prompt carried, matched by the companion\nbecause the prompt ends with the message it pasted (ADR 0051, plan 122 PR 4).",
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "mixed": {
          "description": "With `message_id`: the prompt holds text before the message (someone was typing).",
          "type": "boolean"
        },
        "notification_type": {
          "description": "`notification_type` for `Notification` events, such as `permission_prompt` or `idle_prompt`.",
          "type": [
            "string",
            "null"
          ]
        },
        "payload": {
          "description": "The raw hook payload, for traces and for fields this version does not lift."
        },
        "permission_mode": {
          "type": [
            "string",
            "null"
          ]
        },
        "received_at": {
          "description": "When the companion received it.",
          "type": "string",
          "format": "date-time"
        },
        "session_id": {
          "description": "Claude Code `session_id`.",
          "type": "string"
        },
        "tool_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "transcript_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "truncated": {
          "description": "The prompt or reply text in `payload` was cut to `Limits.session_log_max_chars`.",
          "type": "boolean"
        }
      },
      "required": [
        "session_id",
        "hook_event_name",
        "cwd",
        "received_at"
      ]
    },
    "HookEventKind": {
      "description": "Hook event names we forward. Unknown names arrive as `Unknown` and are kept, not dropped.",
      "type": "string",
      "enum": [
        "SessionStart",
        "UserPromptSubmit",
        "PreToolUse",
        "PostToolUse",
        "PostToolUseFailure",
        "Notification",
        "Stop",
        "StopFailure",
        "SessionEnd",
        "Unknown"
      ]
    },
    "IssueRef": {
      "description": "A GitHub issue, addressed as `owner/name#number`.",
      "type": "object",
      "properties": {
        "number": {
          "description": "Issue number within the repository.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "repo": {
          "description": "Repository in `owner/name` form.",
          "type": "string"
        }
      },
      "required": [
        "repo",
        "number"
      ]
    },
    "LaunchResult": {
      "description": "Companion → server: what happened to a launch command.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "command_id": {
              "type": "string",
              "format": "uuid"
            },
            "draft_restored": {
              "description": "The command's `draft` was written into the new worktree (ADR 0053).",
              "type": "boolean"
            },
            "outcome": {
              "type": "string",
              "const": "started"
            },
            "restore_skipped": {
              "description": "Why the command's `draft` was not written, when it was not.",
              "anyOf": [
                {
                  "$ref": "#/$defs/RestoreSkipped"
                },
                {
                  "type": "null"
                }
              ]
            },
            "session_id": {
              "type": "string",
              "format": "uuid"
            },
            "tmux_session": {
              "type": "string"
            },
            "worktree": {
              "type": "string"
            }
          },
          "required": [
            "outcome",
            "command_id",
            "session_id",
            "worktree",
            "tmux_session",
            "at"
          ]
        },
        {
          "type": "object",
          "properties": {
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "command_id": {
              "type": "string",
              "format": "uuid"
            },
            "detail": {
              "type": "string"
            },
            "outcome": {
              "type": "string",
              "const": "refused"
            },
            "reason": {
              "$ref": "#/$defs/RefusalReason"
            }
          },
          "required": [
            "outcome",
            "command_id",
            "reason",
            "detail",
            "at"
          ]
        },
        {
          "type": "object",
          "properties": {
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "command_id": {
              "type": "string",
              "format": "uuid"
            },
            "error": {
              "type": "string"
            },
            "outcome": {
              "type": "string",
              "const": "failed"
            }
          },
          "required": [
            "outcome",
            "command_id",
            "error",
            "at"
          ]
        }
      ]
    },
    "MessageRefusal": {
      "description": "Why the companion did not type a message.",
      "oneOf": [
        {
          "description": "The message's user is not this companion's paired user (ADR 0004).",
          "type": "string",
          "const": "not_paired_user"
        },
        {
          "description": "No session this companion launched has that launch id.",
          "type": "string",
          "const": "not_launched_here"
        },
        {
          "description": "The launch is known but has no live session to type into.",
          "type": "string",
          "const": "unknown_session"
        },
        {
          "description": "Longer than `Limits.session_message_max_chars`.",
          "type": "string",
          "const": "too_long"
        },
        {
          "description": "The session's tmux pane is not known.",
          "type": "string",
          "const": "no_pane"
        },
        {
          "description": "`plan_approved` for a companion whose installed skill has no `plan.ts handoff`.",
          "type": "string",
          "const": "skill_outdated"
        }
      ]
    },
    "RefusalReason": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "attempt_limit_reached"
          ]
        },
        {
          "description": "The command's user is not this companion's paired user.",
          "type": "string",
          "const": "not_paired_user"
        },
        {
          "description": "A session for this issue is already running on this machine.",
          "type": "string",
          "const": "already_running"
        },
        {
          "description": "tmux or claude missing or below the pinned version.",
          "type": "string",
          "const": "missing_dependency"
        }
      ]
    },
    "RestoreSkipped": {
      "description": "Why a companion did not write a launch's draft (ADR 0053, plan 122 §D5).",
      "oneOf": [
        {
          "description": "The launch reused a worktree whose files differ from the draft: they are left alone.",
          "type": "string",
          "const": "worktree_differs"
        },
        {
          "description": "A path is absolute or leaves the worktree: nothing was written.",
          "type": "string",
          "const": "path_outside"
        }
      ]
    },
    "RoomReply": {
      "description": "Companion → server: an agent's answer to a room turn (ADR 0057).",
      "type": "object",
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "cost_usd": {
          "description": "What a fork turn cost; it counts on the issue and the owner's spend cap.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "fork_session_id": {
          "description": "A fork turn's session, for the next turn's `--resume`.",
          "type": [
            "string",
            "null"
          ]
        },
        "message_id": {
          "description": "The `room_turn` session message this answers.",
          "type": "string",
          "format": "uuid"
        },
        "text": {
          "description": "The reply, cut to `Limits.session_log_max_chars`; empty when the turn failed.",
          "type": "string"
        },
        "turn_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "message_id",
        "turn_id",
        "text",
        "at"
      ]
    },
    "SessionMessageResult": {
      "description": "Companion → server: the answer to one `SessionMessage`.",
      "type": "object",
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "message_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "oneOf": [
        {
          "description": "Typed into the session, once. A repeated push of a delivered id answers this again\nwithout typing.",
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "const": "delivered"
            }
          },
          "required": [
            "outcome"
          ]
        },
        {
          "description": "The session was working; nothing was typed. The server queues it again.",
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "const": "not_idle"
            }
          },
          "required": [
            "outcome"
          ]
        },
        {
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "const": "refused"
            },
            "reason": {
              "$ref": "#/$defs/MessageRefusal"
            }
          },
          "required": [
            "outcome",
            "reason"
          ]
        },
        {
          "description": "The companion stopped while pasting this id: whether it reached the session is unknown.",
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "const": "interrupted"
            }
          },
          "required": [
            "outcome"
          ]
        },
        {
          "description": "The paste failed; nothing was typed.",
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            },
            "outcome": {
              "type": "string",
              "const": "failed"
            }
          },
          "required": [
            "outcome",
            "error"
          ]
        }
      ],
      "required": [
        "message_id",
        "at"
      ]
    },
    "SessionState": {
      "description": "One session as the companion sees it. Identity comes from the branch (ADR 0006).",
      "type": "object",
      "properties": {
        "blocked_by": {
          "description": "Which hook blocked the session, with `status = blocked` (ADR 0043). Absent from an\nolder companion and for a block tmux-ide reported: read as mid-turn.",
          "anyOf": [
            {
              "$ref": "#/$defs/BlockCause"
            },
            {
              "type": "null"
            }
          ]
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "branch_drift": {
          "description": "A launched session that has moved off its launch branch: the branch it is on now. It\nkeeps its launch issue (its spend cap and telemetry are that issue's); this says so.",
          "type": [
            "string",
            "null"
          ]
        },
        "companion_id": {
          "type": "string",
          "format": "uuid"
        },
        "cwd": {
          "type": "string"
        },
        "hooks_lost": {
          "description": "The companion restarted and could not take its old hook port back, so this launched\nsession's hooks go nowhere: chat and mirroring need a relaunch (plan 122 §D1).",
          "type": "boolean"
        },
        "issue": {
          "description": "Resolved from the branch, or from the launch when the branch does not follow the convention.",
          "anyOf": [
            {
              "$ref": "#/$defs/IssueRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_seen": {
          "type": "string",
          "format": "date-time"
        },
        "launch_id": {
          "description": "The Rubato launch this session belongs to, when Rubato launched it (ADR 0051).",
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "repo": {
          "description": "`owner/name` from `origin`.",
          "type": [
            "string",
            "null"
          ]
        },
        "session_id": {
          "description": "Claude Code session id, when known.",
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/StateSource"
        },
        "spend_usd": {
          "description": "Spend so far, summed from the transcript (A11).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "status": {
          "$ref": "#/$defs/SessionStatus"
        },
        "tmux": {
          "anyOf": [
            {
              "$ref": "#/$defs/TmuxLocation"
            },
            {
              "type": "null"
            }
          ]
        },
        "user": {
          "description": "GitHub login of the paired user.",
          "type": "string"
        },
        "worktree": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "companion_id",
        "user",
        "cwd",
        "status",
        "source",
        "last_seen"
      ]
    },
    "SessionStatus": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "working",
            "idle",
            "blocked",
            "ended"
          ]
        },
        {
          "description": "No trustworthy signal. Never rendered as working.",
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "StaleSession": {
      "description": "Emitted once when a *working* session goes quiet for longer than the stale threshold.",
      "type": "object",
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "companion_id": {
          "type": "string",
          "format": "uuid"
        },
        "issue": {
          "anyOf": [
            {
              "$ref": "#/$defs/IssueRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_seen": {
          "type": "string",
          "format": "date-time"
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "silent_for_secs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "companion_id",
        "last_seen",
        "silent_for_secs",
        "at"
      ]
    },
    "StateSource": {
      "description": "Where a status came from. Anything not hook-derived is rendered *unknown* (A10).",
      "oneOf": [
        {
          "description": "A Claude Code hook forwarded by the companion.",
          "type": "string",
          "const": "hook"
        },
        {
          "description": "tmux-ide state with hook authority (`since` set).",
          "type": "string",
          "const": "tmux_ide"
        },
        {
          "description": "tmux-ide state from screen matching. Not trusted.",
          "type": "string",
          "const": "scraped"
        },
        {
          "description": "The companion just launched it; no event yet.",
          "type": "string",
          "const": "launch"
        },
        {
          "description": "A headless companion holds the session's turn as its own child process (ADR 0062): the\nturn's end, reply and liveness come from that process, not from tmux or hooks. Sent only\nto a server that announced `session_stop`.",
          "type": "string",
          "const": "headless"
        }
      ]
    },
    "TmuxLocation": {
      "type": "object",
      "properties": {
        "pane": {
          "description": "tmux pane id such as `%12`.",
          "type": [
            "string",
            "null"
          ]
        },
        "session": {
          "type": "string"
        },
        "socket": {
          "type": [
            "string",
            "null"
          ]
        },
        "window": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "session"
      ]
    }
  }
}
