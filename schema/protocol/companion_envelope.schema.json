{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CompanionEnvelope",
  "type": "object",
  "properties": {
    "message": {
      "$ref": "#/$defs/CompanionMessage"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "seq": {
      "description": "Monotonic per companion, starting at 1, persisted across restarts.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    }
  },
  "required": [
    "seq",
    "sent_at",
    "message"
  ],
  "$defs": {
    "CapHit": {
      "description": "A cap was hit. An event, not a log line; the issue becomes *Blocked*.",
      "type": "object",
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "issue": {
          "$ref": "#/$defs/IssueRef"
        },
        "kind": {
          "$ref": "#/$defs/CapKind"
        },
        "limit": {
          "type": "number",
          "format": "double"
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "issue",
        "kind",
        "value",
        "limit",
        "at"
      ]
    },
    "CapKind": {
      "type": "string",
      "enum": [
        "spend",
        "attempts"
      ]
    },
    "CompanionMessage": {
      "description": "Companion → server.",
      "oneOf": [
        {
          "description": "First message after connect. Carries the pairing identity and where to resume from.",
          "type": "object",
          "properties": {
            "companion_id": {
              "type": "string",
              "format": "uuid"
            },
            "companion_version": {
              "type": "string"
            },
            "last_seen_server_seq": {
              "description": "Last server sequence the companion has seen; the server replays newer commands.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "protocol_version": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "hello"
            },
            "user": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "companion_id",
            "user",
            "companion_version",
            "protocol_version",
            "last_seen_server_seq"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "heartbeat"
            }
          },
          "$ref": "#/$defs/Heartbeat",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "hook"
            }
          },
          "$ref": "#/$defs/HookEvent",
          "required": [
            "type"
          ]
        },
        {
          "description": "Full snapshot of the sessions this companion sees. Replaces the previous snapshot.",
          "type": "object",
          "properties": {
            "sessions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SessionState"
              }
            },
            "type": {
              "type": "string",
              "const": "sessions"
            }
          },
          "required": [
            "type",
            "sessions"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "launch"
            }
          },
          "$ref": "#/$defs/LaunchResult",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "cap_hit"
            }
          },
          "$ref": "#/$defs/CapHit",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "stale"
            }
          },
          "$ref": "#/$defs/StaleSession",
          "required": [
            "type"
          ]
        },
        {
          "description": "Acknowledges a server envelope by sequence.",
          "type": "object",
          "properties": {
            "seq": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "ack"
            }
          },
          "required": [
            "type",
            "seq"
          ]
        }
      ]
    },
    "Heartbeat": {
      "description": "The companion's liveness signal.",
      "type": "object",
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "claude_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "companion_id": {
          "type": "string",
          "format": "uuid"
        },
        "companion_version": {
          "type": "string"
        },
        "hostname": {
          "type": "string"
        },
        "tmux_ide_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "user": {
          "type": "string"
        }
      },
      "required": [
        "companion_id",
        "user",
        "at",
        "hostname",
        "companion_version"
      ]
    },
    "HookEvent": {
      "description": "One hook invocation. Common stdin fields are lifted; the full payload travels in `payload`.",
      "type": "object",
      "properties": {
        "cwd": {
          "description": "`cwd` from the payload: the worktree, not the original project dir.",
          "type": "string"
        },
        "hook_event_name": {
          "$ref": "#/$defs/HookEventKind"
        },
        "notification_type": {
          "description": "`notification_type` for `Notification` events, such as `permission_prompt` or `idle_prompt`.",
          "type": [
            "string",
            "null"
          ]
        },
        "payload": {
          "description": "The raw hook payload, for traces and for fields this version does not lift."
        },
        "permission_mode": {
          "type": [
            "string",
            "null"
          ]
        },
        "received_at": {
          "description": "When the companion received it.",
          "type": "string",
          "format": "date-time"
        },
        "session_id": {
          "description": "Claude Code `session_id`.",
          "type": "string"
        },
        "tool_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "transcript_path": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "session_id",
        "hook_event_name",
        "cwd",
        "received_at"
      ]
    },
    "HookEventKind": {
      "description": "Hook event names we forward. Unknown names arrive as `Unknown` and are kept, not dropped.",
      "type": "string",
      "enum": [
        "SessionStart",
        "UserPromptSubmit",
        "PreToolUse",
        "PostToolUse",
        "PostToolUseFailure",
        "Notification",
        "Stop",
        "StopFailure",
        "SessionEnd",
        "Unknown"
      ]
    },
    "IssueRef": {
      "description": "A GitHub issue, addressed as `owner/name#number`.",
      "type": "object",
      "properties": {
        "number": {
          "description": "Issue number within the repository.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "repo": {
          "description": "Repository in `owner/name` form.",
          "type": "string"
        }
      },
      "required": [
        "repo",
        "number"
      ]
    },
    "LaunchResult": {
      "description": "Companion → server: what happened to a launch command.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "command_id": {
              "type": "string",
              "format": "uuid"
            },
            "outcome": {
              "type": "string",
              "const": "started"
            },
            "session_id": {
              "type": "string",
              "format": "uuid"
            },
            "tmux_session": {
              "type": "string"
            },
            "worktree": {
              "type": "string"
            }
          },
          "required": [
            "outcome",
            "command_id",
            "session_id",
            "worktree",
            "tmux_session",
            "at"
          ]
        },
        {
          "type": "object",
          "properties": {
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "command_id": {
              "type": "string",
              "format": "uuid"
            },
            "detail": {
              "type": "string"
            },
            "outcome": {
              "type": "string",
              "const": "refused"
            },
            "reason": {
              "$ref": "#/$defs/RefusalReason"
            }
          },
          "required": [
            "outcome",
            "command_id",
            "reason",
            "detail",
            "at"
          ]
        },
        {
          "type": "object",
          "properties": {
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "command_id": {
              "type": "string",
              "format": "uuid"
            },
            "error": {
              "type": "string"
            },
            "outcome": {
              "type": "string",
              "const": "failed"
            }
          },
          "required": [
            "outcome",
            "command_id",
            "error",
            "at"
          ]
        }
      ]
    },
    "RefusalReason": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "attempt_limit_reached"
          ]
        },
        {
          "description": "The command's user is not this companion's paired user.",
          "type": "string",
          "const": "not_paired_user"
        },
        {
          "description": "A session for this issue is already running on this machine.",
          "type": "string",
          "const": "already_running"
        },
        {
          "description": "tmux-ide or claude missing or below the pinned version.",
          "type": "string",
          "const": "missing_dependency"
        }
      ]
    },
    "SessionState": {
      "description": "One session as the companion sees it. Identity comes from the branch (ADR 0006).",
      "type": "object",
      "properties": {
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "branch_drift": {
          "description": "A launched session that has moved off its launch branch: the branch it is on now. It\nkeeps its launch issue (its spend cap and telemetry are that issue's); this says so.",
          "type": [
            "string",
            "null"
          ]
        },
        "companion_id": {
          "type": "string",
          "format": "uuid"
        },
        "cwd": {
          "type": "string"
        },
        "issue": {
          "description": "Resolved from the branch, or from the launch when the branch does not follow the convention.",
          "anyOf": [
            {
              "$ref": "#/$defs/IssueRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_seen": {
          "type": "string",
          "format": "date-time"
        },
        "repo": {
          "description": "`owner/name` from `origin`.",
          "type": [
            "string",
            "null"
          ]
        },
        "session_id": {
          "description": "Claude Code session id, when known.",
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/StateSource"
        },
        "spend_usd": {
          "description": "Spend so far, summed from the transcript (A11).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "status": {
          "$ref": "#/$defs/SessionStatus"
        },
        "tmux": {
          "anyOf": [
            {
              "$ref": "#/$defs/TmuxLocation"
            },
            {
              "type": "null"
            }
          ]
        },
        "user": {
          "description": "GitHub login of the paired user.",
          "type": "string"
        },
        "worktree": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "companion_id",
        "user",
        "cwd",
        "status",
        "source",
        "last_seen"
      ]
    },
    "SessionStatus": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "working",
            "idle",
            "blocked",
            "ended"
          ]
        },
        {
          "description": "No trustworthy signal. Never rendered as working.",
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "StaleSession": {
      "description": "Emitted once when a *working* session goes quiet for longer than the stale threshold.",
      "type": "object",
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "companion_id": {
          "type": "string",
          "format": "uuid"
        },
        "issue": {
          "anyOf": [
            {
              "$ref": "#/$defs/IssueRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_seen": {
          "type": "string",
          "format": "date-time"
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "silent_for_secs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "companion_id",
        "last_seen",
        "silent_for_secs",
        "at"
      ]
    },
    "StateSource": {
      "description": "Where a status came from. Anything not hook-derived is rendered *unknown* (A10).",
      "oneOf": [
        {
          "description": "A Claude Code hook forwarded by the companion.",
          "type": "string",
          "const": "hook"
        },
        {
          "description": "tmux-ide state with hook authority (`since` set).",
          "type": "string",
          "const": "tmux_ide"
        },
        {
          "description": "tmux-ide state from screen matching. Not trusted.",
          "type": "string",
          "const": "scraped"
        },
        {
          "description": "The companion just launched it; no event yet.",
          "type": "string",
          "const": "launch"
        }
      ]
    },
    "TmuxLocation": {
      "type": "object",
      "properties": {
        "pane": {
          "description": "tmux pane id such as `%12`.",
          "type": [
            "string",
            "null"
          ]
        },
        "session": {
          "type": "string"
        },
        "socket": {
          "type": [
            "string",
            "null"
          ]
        },
        "window": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "session"
      ]
    }
  }
}
