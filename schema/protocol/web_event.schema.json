{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WebEvent",
  "description": "Pushed to browsers over `/ws/web`. Clients refetch the overview on `Changed`.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "changed"
        },
        "workspace": {
          "description": "The workspace the change belongs to, for changes of one map only (layout, draft, map\nload; ADR 0049). Absent: every workspace may have changed, so every client refetches.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "type",
        "at",
        "reason"
      ]
    },
    {
      "description": "One resource changed that the overview does not carry (plan 122): only a view showing it\nrefetches it. The overview is not refetched.",
      "type": "object",
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "resource": {
          "$ref": "#/$defs/WebResource"
        },
        "type": {
          "type": "string",
          "const": "updated"
        }
      },
      "required": [
        "type",
        "at",
        "resource"
      ]
    }
  ],
  "$defs": {
    "WebResource": {
      "description": "A resource a view can refetch on its own.",
      "oneOf": [
        {
          "description": "`GET` `session_message::routes::LAUNCH_MESSAGES` for this launch.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "launch_messages"
            },
            "launch_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "kind",
            "launch_id"
          ]
        },
        {
          "description": "`GET` `session_log::routes::LAUNCH_LOG` for this launch.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "launch_log"
            },
            "launch_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "kind",
            "launch_id"
          ]
        }
      ]
    }
  }
}
