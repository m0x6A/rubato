{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StaleSession",
  "description": "Emitted once when a *working* session goes quiet for longer than the stale threshold.",
  "type": "object",
  "properties": {
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "companion_id": {
      "type": "string",
      "format": "uuid"
    },
    "issue": {
      "anyOf": [
        {
          "$ref": "#/$defs/IssueRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "last_seen": {
      "type": "string",
      "format": "date-time"
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "silent_for_secs": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    }
  },
  "required": [
    "companion_id",
    "last_seen",
    "silent_for_secs",
    "at"
  ],
  "$defs": {
    "IssueRef": {
      "description": "A GitHub issue, addressed as `owner/name#number`.",
      "type": "object",
      "properties": {
        "number": {
          "description": "Issue number within the repository.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "repo": {
          "description": "Repository in `owner/name` form.",
          "type": "string"
        }
      },
      "required": [
        "repo",
        "number"
      ]
    }
  }
}
