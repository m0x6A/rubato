{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FleetRequest",
  "description": "Companion → server: one fleet tool call of a lead launch. Sent only while the link is up and\nnever kept in the outbox, so a reconnect never replays it late.",
  "type": "object",
  "properties": {
    "action": {
      "$ref": "#/$defs/FleetAction"
    },
    "lead_launch_id": {
      "description": "The launch the call came from: the companion took it from `X-Rubato-Launch`.",
      "type": "string",
      "format": "uuid"
    },
    "request_id": {
      "description": "The agent's own id when it retries a pending call, else a new one the companion made.",
      "type": "string",
      "format": "uuid"
    }
  },
  "required": [
    "request_id",
    "lead_launch_id",
    "action"
  ],
  "$defs": {
    "FleetAction": {
      "description": "What a lead asks for.",
      "oneOf": [
        {
          "description": "Its owner's launches in the lead's workspace.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "list"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "description": "A worker on an issue, as its owner, on one of the owner's connected companions.",
          "type": "object",
          "properties": {
            "companion_id": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            },
            "issue": {
              "$ref": "#/$defs/IssueRef"
            },
            "kind": {
              "type": "string",
              "const": "launch"
            },
            "slug": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "issue"
          ]
        },
        {
          "description": "A chat message to a worker this lead launched.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "message"
            },
            "launch_id": {
              "type": "string",
              "format": "uuid"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "launch_id",
            "text"
          ]
        },
        {
          "description": "A stop for a worker this lead launched.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "stop"
            },
            "launch_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "kind",
            "launch_id"
          ]
        }
      ]
    },
    "IssueRef": {
      "description": "A GitHub issue, addressed as `owner/name#number`.",
      "type": "object",
      "properties": {
        "number": {
          "description": "Issue number within the repository.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "repo": {
          "description": "Repository in `owner/name` form.",
          "type": "string"
        }
      },
      "required": [
        "repo",
        "number"
      ]
    }
  }
}
