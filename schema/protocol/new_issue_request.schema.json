{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NewIssueRequest",
  "description": "`POST /api/issues`. Each list item is one line of its section.",
  "type": "object",
  "properties": {
    "context": {
      "type": [
        "string",
        "null"
      ]
    },
    "does": {
      "description": "\"What the change does\", at least one line.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "know": {
      "description": "\"How we'll know it works\", at least one line; written as checkboxes.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "must_not_break": {
      "description": "\"What it must not break\", at least one line.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "repo": {
      "description": "`owner/name`, a repo the map names.",
      "type": "string"
    },
    "request_id": {
      "description": "Made by the form once per draft; a second submit with the same id creates nothing more.",
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "target": {
      "description": "The part or seam the issue was started from. It is pinned there at creation.",
      "$ref": "#/$defs/MapRef"
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "repo",
    "target",
    "title",
    "summary",
    "does",
    "know",
    "must_not_break"
  ],
  "$defs": {
    "MapRef": {
      "description": "A reference into the system map: a node or a seam. Ids come from `system-map.yml` (ADR 0007).",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "node"
            }
          },
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "seam"
            }
          },
          "required": [
            "kind",
            "id"
          ]
        }
      ]
    }
  }
}
