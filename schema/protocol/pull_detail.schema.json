{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PullDetail",
  "description": "A pull request's view (`GET /api/pulls/{owner}/{repo}/{number}`, ADR 0034): read when opened,\ncached 30 s. Titles and bodies are shown as text.",
  "type": "object",
  "properties": {
    "author": {
      "type": "string"
    },
    "base": {
      "type": "string"
    },
    "body": {
      "description": "The description, as written (plain text, design A4).",
      "type": "string",
      "default": ""
    },
    "branch": {
      "type": "string"
    },
    "check_runs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CheckRun"
      }
    },
    "checks": {
      "description": "The folded check runs at the head.",
      "$ref": "#/$defs/ChecksStatus"
    },
    "draft": {
      "type": "boolean"
    },
    "files": {
      "$ref": "#/$defs/FilesSummary"
    },
    "fork": {
      "description": "The head is in another repo (ADR 0034: never merged from Rubato).",
      "type": "boolean",
      "default": false
    },
    "head_sha": {
      "type": "string"
    },
    "issue": {
      "description": "The issue the branch names (ADR 0006).",
      "anyOf": [
        {
          "$ref": "#/$defs/IssueRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "merge": {
      "$ref": "#/$defs/MergeOffer"
    },
    "mergeable": {
      "description": "GitHub's `mergeable`; absent while GitHub is still computing it.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "merged_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "number": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "outside_reviews": {
      "description": "Reviews from outside the team: counted, not shown (design A7).",
      "type": "integer",
      "format": "uint32",
      "default": 0,
      "minimum": 0
    },
    "read_at": {
      "description": "When GitHub was read for this view; a cached view is at most 30 s old.",
      "type": "string",
      "format": "date-time"
    },
    "repo": {
      "type": "string"
    },
    "reviews": {
      "description": "The latest review per team reviewer.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/PullReview"
      }
    },
    "state": {
      "$ref": "#/$defs/PullState"
    },
    "title": {
      "type": "string"
    },
    "url": {
      "type": "string"
    }
  },
  "required": [
    "repo",
    "number",
    "title",
    "author",
    "state",
    "draft",
    "branch",
    "base",
    "head_sha",
    "checks",
    "files",
    "url",
    "merge",
    "read_at"
  ],
  "$defs": {
    "ChangedFile": {
      "description": "One changed file.",
      "type": "object",
      "properties": {
        "additions": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "deletions": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "additions",
        "deletions"
      ]
    },
    "CheckRun": {
      "description": "One check run at the head.",
      "type": "object",
      "properties": {
        "conclusion": {
          "description": "`success`, `failure`, `neutral`, … once completed.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "status": {
          "description": "`queued`, `in_progress` or `completed`, as GitHub says.",
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "status",
        "url"
      ]
    },
    "ChecksStatus": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "green",
            "red",
            "pending"
          ]
        },
        {
          "description": "No checks configured.",
          "type": "string",
          "const": "none"
        }
      ]
    },
    "FilesSummary": {
      "description": "What the pull request changes, from one page of 100 files.",
      "type": "object",
      "properties": {
        "additions": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "count": {
          "description": "Files on the page read.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "deletions": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "top": {
          "description": "The [`TOP_FILES`] with the most changed lines.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChangedFile"
          }
        },
        "truncated": {
          "description": "The page was full: the pull request changes more files than `count`.",
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "count",
        "additions",
        "deletions"
      ]
    },
    "IssueRef": {
      "description": "A GitHub issue, addressed as `owner/name#number`.",
      "type": "object",
      "properties": {
        "number": {
          "description": "Issue number within the repository.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "repo": {
          "description": "Repository in `owner/name` form.",
          "type": "string"
        }
      },
      "required": [
        "repo",
        "number"
      ]
    },
    "MergeMethod": {
      "description": "How a pull request is merged: `merge_method` on GitHub's merge call.",
      "type": "string",
      "enum": [
        "merge",
        "squash",
        "rebase"
      ]
    },
    "MergeOffer": {
      "description": "What *Merge* offers the person, from [`merge_refusal`] with no ask.",
      "type": "object",
      "properties": {
        "can_merge": {
          "type": "boolean"
        },
        "default_method": {
          "description": "Squash when allowed (ADR 0033), else the first allowed.",
          "anyOf": [
            {
              "$ref": "#/$defs/MergeMethod"
            },
            {
              "type": "null"
            }
          ]
        },
        "methods": {
          "description": "The methods the repo allows; empty without the person's facts.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/MergeMethod"
          }
        },
        "plan_gate": {
          "$ref": "#/$defs/PlanGate"
        },
        "stacked_above": {
          "description": "Open pull requests whose base is this head branch: a squash makes them conflict\n(plan 82 Decision 7).",
          "type": "integer",
          "format": "uint32",
          "default": 0,
          "minimum": 0
        },
        "why_not": {
          "description": "A [`reason`] when `can_merge` is false.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "can_merge",
        "plan_gate"
      ]
    },
    "PlanGate": {
      "description": "What the plan of the linked issue says about merging (ADR 0033, plan 82 Decisions 1–3).",
      "oneOf": [
        {
          "description": "The issue has no plan signal at all (a trivial change): GitHub's branch protection alone.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "no_plan"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "description": "A counted approval names the plan at the head being merged.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "approved"
            },
            "sha": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "sha"
          ]
        },
        {
          "description": "The issue has a plan and no counted approval names the plan at that head.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "not_approved"
            },
            "why": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "why"
          ]
        }
      ]
    },
    "PullReview": {
      "description": "The latest review of one team reviewer (ADR 0027's trusted authors).",
      "type": "object",
      "properties": {
        "author": {
          "type": "string"
        },
        "state": {
          "description": "`APPROVED`, `CHANGES_REQUESTED`, `COMMENTED` or `DISMISSED`, as GitHub says.",
          "type": "string"
        },
        "submitted_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "author",
        "state",
        "submitted_at"
      ]
    },
    "PullState": {
      "description": "Whether the pull request is open, closed without merging, or merged.",
      "type": "string",
      "enum": [
        "open",
        "closed",
        "merged"
      ]
    }
  }
}
