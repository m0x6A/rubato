{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PairingInfo",
  "type": "object",
  "properties": {
    "client": {
      "description": "Interactive or headless (ADR 0062): what the web shows on the lane. Older servers omit it.",
      "$ref": "#/$defs/ClientKind"
    },
    "companion_id": {
      "type": "string",
      "format": "uuid"
    },
    "connected": {
      "description": "A websocket is open right now.",
      "type": "boolean"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "hostname": {
      "type": "string"
    },
    "last_seen": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "revoked_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "user": {
      "type": "string"
    }
  },
  "required": [
    "companion_id",
    "user",
    "hostname",
    "created_at",
    "connected"
  ],
  "$defs": {
    "ClientKind": {
      "description": "What kind of client a companion is (ADR 0062). Every client has one owner and never approves.",
      "oneOf": [
        {
          "description": "Sessions in the developer's tmux, input pasted into the pane.",
          "type": "string",
          "const": "interactive"
        },
        {
          "description": "No terminal: each turn is a `claude -p` child process the companion holds.",
          "type": "string",
          "const": "headless"
        }
      ]
    }
  }
}
