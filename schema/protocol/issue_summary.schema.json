{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IssueSummary",
  "description": "Everything the map view needs about one issue.",
  "type": "object",
  "properties": {
    "approval": {
      "description": "The newest approval a member posted, and whether it is of the plan as it is now. A\nbadge, not a progress state.",
      "anyOf": [
        {
          "$ref": "#/$defs/ApprovalState"
        },
        {
          "type": "null"
        }
      ]
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DecisionRecord"
      }
    },
    "fit": {
      "description": "Where the plan fits the map, and whether it does (ADR 0029). Absent without a plan file.",
      "anyOf": [
        {
          "$ref": "#/$defs/PlanFit"
        },
        {
          "type": "null"
        }
      ]
    },
    "issue": {
      "$ref": "#/$defs/IssueRef"
    },
    "pins": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MapRef"
      }
    },
    "plan": {
      "anyOf": [
        {
          "$ref": "#/$defs/Plan"
        },
        {
          "type": "null"
        }
      ]
    },
    "progress": {
      "$ref": "#/$defs/Progress"
    },
    "pull_request": {
      "anyOf": [
        {
          "$ref": "#/$defs/PullRequestState"
        },
        {
          "type": "null"
        }
      ]
    },
    "review": {
      "description": "The newest design review a member posted (ADR 0027).",
      "anyOf": [
        {
          "$ref": "#/$defs/ReviewRecord"
        },
        {
          "type": "null"
        }
      ]
    },
    "sessions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SessionState"
      }
    },
    "spend_usd": {
      "description": "Sum over this issue's sessions.",
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "url": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "issue",
    "pins",
    "progress"
  ],
  "$defs": {
    "AffectedPart": {
      "description": "One row of the affected-parts table. This is what paints the map.",
      "type": "object",
      "properties": {
        "change": {
          "description": "What changes, in one line.",
          "type": "string"
        },
        "node": {
          "description": "Node id from the map.",
          "type": "string"
        },
        "seams": {
          "description": "Seam ids this change touches. Each needs an O-row.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "$ref": "#/$defs/PartStatus"
        }
      },
      "required": [
        "node",
        "status",
        "change"
      ]
    },
    "ApprovalRecord": {
      "description": "A person's approval of a plan, first line `Approved: plan <sha>` or\n`Approved: plan <sha> on <branch>` (ADR 0027). Only a trusted author's approval counts.",
      "type": "object",
      "properties": {
        "author": {
          "type": "string"
        },
        "branch": {
          "description": "The branch the approval names; else the branch Rubato reads the plan from.",
          "type": [
            "string",
            "null"
          ]
        },
        "comment_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "issue": {
          "$ref": "#/$defs/IssueRef"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha": {
          "description": "The plan hash approved (checkboxes cleared, git blob sha). Absent when the comment names\nnone: the approval then shows as \"version not named\".",
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "issue",
        "comment_id",
        "author",
        "created_at",
        "url"
      ]
    },
    "ApprovalState": {
      "description": "The newest counted approval of an issue's plan, and whether it is of the current version.",
      "type": "object",
      "properties": {
        "current_sha": {
          "description": "The hash of the plan compared with, when there is one.",
          "type": [
            "string",
            "null"
          ]
        },
        "record": {
          "$ref": "#/$defs/ApprovalRecord"
        },
        "version": {
          "$ref": "#/$defs/ApprovalVersion"
        }
      },
      "required": [
        "record",
        "version"
      ]
    },
    "ApprovalVersion": {
      "description": "How an approval relates to the plan Rubato holds now.",
      "oneOf": [
        {
          "description": "The approved hash is the plan's hash now.",
          "type": "string",
          "const": "current"
        },
        {
          "description": "The plan changed after the approval (finding `ApprovalStale`).",
          "type": "string",
          "const": "earlier"
        },
        {
          "description": "The comment names no hash.",
          "type": "string",
          "const": "not_named"
        },
        {
          "description": "No plan file to compare with on that branch.",
          "type": "string",
          "const": "no_plan"
        },
        {
          "description": "The approval names the plan as it is now, but the plan does not fit the map, so the\napproval does not count (ADR 0029, finding `ApprovedWithoutFit`).",
          "type": "string",
          "const": "does_not_fit"
        }
      ]
    },
    "Assumption": {
      "description": "A decision the plan had to make that nothing settled.",
      "type": "object",
      "properties": {
        "alternatives": {
          "type": [
            "string",
            "null"
          ]
        },
        "chosen": {
          "type": "string"
        },
        "decision": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/AssumptionScope"
        }
      },
      "required": [
        "id",
        "decision",
        "chosen",
        "scope"
      ]
    },
    "AssumptionScope": {
      "oneOf": [
        {
          "description": "Inside one node: assumed and labelled.",
          "type": "string",
          "const": "node"
        },
        {
          "description": "On a seam: blocks until a human answers.",
          "type": "string",
          "const": "seam"
        }
      ]
    },
    "ChecksStatus": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "green",
            "red",
            "pending"
          ]
        },
        {
          "description": "No checks configured.",
          "type": "string",
          "const": "none"
        }
      ]
    },
    "DataModel": {
      "description": "One row of the plan's Data models table (ADR 0031): a model on the part that owns it, and the\nseam it travels over, if any.",
      "type": "object",
      "properties": {
        "change": {
          "$ref": "#/$defs/ModelChange"
        },
        "crosses": {
          "description": "Seam id the model crosses. Must be touched in Affected parts.",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/DataModelKind"
        },
        "model": {
          "description": "The model's name or names, as written, backticks removed.",
          "type": "string"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "part": {
          "description": "Node id of the part that owns the model. Must be in Affected parts.",
          "type": "string"
        }
      },
      "required": [
        "model",
        "kind",
        "part",
        "change"
      ]
    },
    "DataModelKind": {
      "type": "string",
      "enum": [
        "table",
        "type",
        "schema",
        "event",
        "file"
      ]
    },
    "DecisionRecord": {
      "description": "A decision recorded as an issue comment with the `Decision:` template (ADR 0014).",
      "type": "object",
      "properties": {
        "author": {
          "type": "string"
        },
        "chosen": {
          "type": [
            "string",
            "null"
          ]
        },
        "comment_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "context": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "issue": {
          "$ref": "#/$defs/IssueRef"
        },
        "options": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "why": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "issue",
        "comment_id",
        "author",
        "title",
        "created_at",
        "url"
      ]
    },
    "FitReason": {
      "description": "Why a plan does not fit the map (ADR 0029). Each one alone makes `PlanFit::fits` false.",
      "oneOf": [
        {
          "description": "The plan file does not parse.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "parse_error"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "message"
          ]
        },
        {
          "description": "Node or seam ids the map does not declare.",
          "type": "object",
          "properties": {
            "ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "kind": {
              "type": "string",
              "const": "unknown_ids"
            }
          },
          "required": [
            "kind",
            "ids"
          ]
        },
        {
          "description": "A flow's seam does not join the flow's two parts.",
          "type": "object",
          "properties": {
            "from": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "flow_off_seam"
            },
            "seam": {
              "type": "string"
            },
            "to": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "from",
            "to",
            "seam"
          ]
        },
        {
          "description": "A seam in Affected parts with no O-row.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "missing_o_row"
            },
            "seam": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "seam"
          ]
        },
        {
          "description": "A data model on a part that is not a row of Affected parts (ADR 0031).",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "model_off_part"
            },
            "model": {
              "type": "string"
            },
            "part": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "model",
            "part"
          ]
        },
        {
          "description": "A data model crossing a seam no row of Affected parts touches (ADR 0031).",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "model_off_seam"
            },
            "model": {
              "type": "string"
            },
            "seam": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "model",
            "seam"
          ]
        }
      ]
    },
    "FlowKind": {
      "description": "Data moves; control tells the other side to do something.",
      "type": "string",
      "enum": [
        "data",
        "control"
      ]
    },
    "IssueRef": {
      "description": "A GitHub issue, addressed as `owner/name#number`.",
      "type": "object",
      "properties": {
        "number": {
          "description": "Issue number within the repository.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "repo": {
          "description": "Repository in `owner/name` form.",
          "type": "string"
        }
      },
      "required": [
        "repo",
        "number"
      ]
    },
    "MapRef": {
      "description": "A reference into the system map: a node or a seam. Ids come from `system-map.yml` (ADR 0007).",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "node"
            }
          },
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "seam"
            }
          },
          "required": [
            "kind",
            "id"
          ]
        }
      ]
    },
    "ModelChange": {
      "type": "string",
      "enum": [
        "new",
        "changed",
        "removed"
      ]
    },
    "ORow": {
      "description": "The 3 am question for one seam: which signal leads back to it, where, and who is woken.",
      "type": "object",
      "properties": {
        "breaks_like": {
          "type": [
            "string",
            "null"
          ]
        },
        "owner": {
          "description": "Node id of the side that owns the fix.",
          "type": "string"
        },
        "panel": {
          "description": "Dashboard panel the signal appears on.",
          "type": "string"
        },
        "seam": {
          "type": "string"
        },
        "signal": {
          "description": "Span, metric or log line, with the `rubato.*` attributes it carries.",
          "type": "string"
        }
      },
      "required": [
        "seam",
        "signal",
        "panel",
        "owner"
      ]
    },
    "PartStatus": {
      "type": "string",
      "enum": [
        "affected",
        "new",
        "quiet"
      ]
    },
    "Plan": {
      "type": "object",
      "properties": {
        "affected_parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AffectedPart"
          }
        },
        "assumed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Assumption"
          }
        },
        "attempt_limit": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "data_models": {
          "description": "The tables, types, schemas, events and files the change introduces, changes or removes,\nfrom its `## Data models` table (ADR 0031). Optional; empty when absent or \"None.\"",
          "type": "array",
          "items": {
            "$ref": "#/$defs/DataModel"
          }
        },
        "flows": {
          "description": "What the plan will send across seams, from its `## Flows` table (ADR 0021). Optional.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlanFlow"
          }
        },
        "git_ref": {
          "description": "Git ref the plan was read from (branch name or commit sha).",
          "type": [
            "string",
            "null"
          ]
        },
        "issue": {
          "$ref": "#/$defs/IssueRef"
        },
        "o_rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ORow"
          }
        },
        "path": {
          "description": "Path of the plan file inside the repository.",
          "type": "string"
        },
        "spend_cap_usd": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "issue",
        "path",
        "affected_parts"
      ]
    },
    "PlanFit": {
      "description": "Where a plan fits the map, and whether it does (ADR 0029). An approval counts only while\n`fits` is true.",
      "type": "object",
      "properties": {
        "fits": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FitReason"
          }
        }
      },
      "required": [
        "fits"
      ]
    },
    "PlanFlow": {
      "description": "One row of the plan's Flows table: something the change sends from one part to another over\na seam. The seam must join the two parts.",
      "type": "object",
      "properties": {
        "carries": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/FlowKind"
        },
        "seam": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      },
      "required": [
        "from",
        "to",
        "seam",
        "kind",
        "carries"
      ]
    },
    "Progress": {
      "description": "Derived progress of one issue, with the time of the newest signal behind it.",
      "type": "object",
      "properties": {
        "issue": {
          "$ref": "#/$defs/IssueRef"
        },
        "last_seen": {
          "type": "string",
          "format": "date-time"
        },
        "pinned_to": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MapRef"
          }
        },
        "reason": {
          "description": "One line on why, for *Blocked* and *Unknown*.",
          "type": [
            "string",
            "null"
          ]
        },
        "session_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "state": {
          "$ref": "#/$defs/ProgressState"
        }
      },
      "required": [
        "issue",
        "state",
        "last_seen"
      ]
    },
    "ProgressState": {
      "oneOf": [
        {
          "description": "Issue exists and is pinned to the map.",
          "type": "string",
          "const": "planned"
        },
        {
          "description": "Session launched for the issue.",
          "type": "string",
          "const": "started"
        },
        {
          "description": "Session working, no plan file yet.",
          "type": "string",
          "const": "designing"
        },
        {
          "description": "Plan file on the branch; affected nodes lit.",
          "type": "string",
          "const": "designed"
        },
        {
          "description": "Session working after the plan.",
          "type": "string",
          "const": "building"
        },
        {
          "description": "Session blocked (hook) or a cap hit.",
          "type": "string",
          "const": "blocked"
        },
        {
          "description": "PR open, checks green.",
          "type": "string",
          "const": "in_review"
        },
        {
          "description": "Merged.",
          "type": "string",
          "const": "done"
        },
        {
          "description": "The signal is not flowing. Trust check first.",
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "PullRequestState": {
      "description": "The pull request for an issue branch.",
      "type": "object",
      "properties": {
        "branch": {
          "type": "string"
        },
        "checks": {
          "$ref": "#/$defs/ChecksStatus"
        },
        "draft": {
          "type": "boolean"
        },
        "merged_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "number": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "open": {
          "type": "boolean"
        },
        "repo": {
          "type": "string"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "repo",
        "number",
        "branch",
        "open",
        "draft",
        "checks",
        "updated_at",
        "url"
      ]
    },
    "ReviewRecord": {
      "description": "A design review posted as an issue comment, first line `Review: <track> — <outcome>`\n(ADR 0027). Only a trusted author's review is kept.",
      "type": "object",
      "properties": {
        "author": {
          "type": "string"
        },
        "comment_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "issue": {
          "$ref": "#/$defs/IssueRef"
        },
        "left_open": {
          "type": [
            "string",
            "null"
          ]
        },
        "outcome": {
          "description": "The rest of the first line, e.g. `passed after fixes`.",
          "type": "string"
        },
        "plan_sha": {
          "description": "The plan version the review read, when its `Plan` section names one.",
          "type": [
            "string",
            "null"
          ]
        },
        "track": {
          "description": "`trivial`, `small` or `full`, as written.",
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "issue",
        "comment_id",
        "author",
        "track",
        "outcome",
        "created_at",
        "url"
      ]
    },
    "SessionState": {
      "description": "One session as the companion sees it. Identity comes from the branch (ADR 0006).",
      "type": "object",
      "properties": {
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "companion_id": {
          "type": "string",
          "format": "uuid"
        },
        "cwd": {
          "type": "string"
        },
        "issue": {
          "description": "Resolved from the branch, or from the launch when the branch does not follow the convention.",
          "anyOf": [
            {
              "$ref": "#/$defs/IssueRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_seen": {
          "type": "string",
          "format": "date-time"
        },
        "repo": {
          "description": "`owner/name` from `origin`.",
          "type": [
            "string",
            "null"
          ]
        },
        "session_id": {
          "description": "Claude Code session id, when known.",
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/StateSource"
        },
        "spend_usd": {
          "description": "Spend so far, summed from the transcript (A11).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "status": {
          "$ref": "#/$defs/SessionStatus"
        },
        "tmux": {
          "anyOf": [
            {
              "$ref": "#/$defs/TmuxLocation"
            },
            {
              "type": "null"
            }
          ]
        },
        "user": {
          "description": "GitHub login of the paired user.",
          "type": "string"
        },
        "worktree": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "companion_id",
        "user",
        "cwd",
        "status",
        "source",
        "last_seen"
      ]
    },
    "SessionStatus": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "working",
            "idle",
            "blocked",
            "ended"
          ]
        },
        {
          "description": "No trustworthy signal. Never rendered as working.",
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "StateSource": {
      "description": "Where a status came from. Anything not hook-derived is rendered *unknown* (A10).",
      "oneOf": [
        {
          "description": "A Claude Code hook forwarded by the companion.",
          "type": "string",
          "const": "hook"
        },
        {
          "description": "tmux-ide state with hook authority (`since` set).",
          "type": "string",
          "const": "tmux_ide"
        },
        {
          "description": "tmux-ide state from screen matching. Not trusted.",
          "type": "string",
          "const": "scraped"
        },
        {
          "description": "The companion just launched it; no event yet.",
          "type": "string",
          "const": "launch"
        }
      ]
    },
    "TmuxLocation": {
      "type": "object",
      "properties": {
        "pane": {
          "description": "tmux pane id such as `%12`.",
          "type": [
            "string",
            "null"
          ]
        },
        "session": {
          "type": "string"
        },
        "socket": {
          "type": [
            "string",
            "null"
          ]
        },
        "window": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "session"
      ]
    }
  }
}
