{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IssueSummary",
  "description": "Everything the map view needs about one issue.",
  "type": "object",
  "properties": {
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DecisionRecord"
      }
    },
    "issue": {
      "$ref": "#/$defs/IssueRef"
    },
    "pins": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MapRef"
      }
    },
    "plan": {
      "anyOf": [
        {
          "$ref": "#/$defs/Plan"
        },
        {
          "type": "null"
        }
      ]
    },
    "progress": {
      "$ref": "#/$defs/Progress"
    },
    "pull_request": {
      "anyOf": [
        {
          "$ref": "#/$defs/PullRequestState"
        },
        {
          "type": "null"
        }
      ]
    },
    "sessions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SessionState"
      }
    },
    "spend_usd": {
      "description": "Sum over this issue's sessions.",
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "url": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "issue",
    "pins",
    "progress"
  ],
  "$defs": {
    "AffectedPart": {
      "description": "One row of the affected-parts table. This is what paints the map.",
      "type": "object",
      "properties": {
        "change": {
          "description": "What changes, in one line.",
          "type": "string"
        },
        "node": {
          "description": "Node id from the map.",
          "type": "string"
        },
        "seams": {
          "description": "Seam ids this change touches. Each needs an O-row.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "$ref": "#/$defs/PartStatus"
        }
      },
      "required": [
        "node",
        "status",
        "change"
      ]
    },
    "Assumption": {
      "description": "A decision the plan had to make that nothing settled.",
      "type": "object",
      "properties": {
        "alternatives": {
          "type": [
            "string",
            "null"
          ]
        },
        "chosen": {
          "type": "string"
        },
        "decision": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/AssumptionScope"
        }
      },
      "required": [
        "id",
        "decision",
        "chosen",
        "scope"
      ]
    },
    "AssumptionScope": {
      "oneOf": [
        {
          "description": "Inside one node: assumed and labelled.",
          "type": "string",
          "const": "node"
        },
        {
          "description": "On a seam: blocks until a human answers.",
          "type": "string",
          "const": "seam"
        }
      ]
    },
    "ChecksStatus": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "green",
            "red",
            "pending"
          ]
        },
        {
          "description": "No checks configured.",
          "type": "string",
          "const": "none"
        }
      ]
    },
    "DecisionRecord": {
      "description": "A decision recorded as an issue comment with the `Decision:` template (ADR 0014).",
      "type": "object",
      "properties": {
        "author": {
          "type": "string"
        },
        "chosen": {
          "type": [
            "string",
            "null"
          ]
        },
        "comment_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "context": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "issue": {
          "$ref": "#/$defs/IssueRef"
        },
        "options": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "why": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "issue",
        "comment_id",
        "author",
        "title",
        "created_at",
        "url"
      ]
    },
    "FlowKind": {
      "description": "Data moves; control tells the other side to do something.",
      "type": "string",
      "enum": [
        "data",
        "control"
      ]
    },
    "IssueRef": {
      "description": "A GitHub issue, addressed as `owner/name#number`.",
      "type": "object",
      "properties": {
        "number": {
          "description": "Issue number within the repository.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "repo": {
          "description": "Repository in `owner/name` form.",
          "type": "string"
        }
      },
      "required": [
        "repo",
        "number"
      ]
    },
    "MapRef": {
      "description": "A reference into the system map: a node or a seam. Ids come from `system-map.yml` (ADR 0007).",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "node"
            }
          },
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "seam"
            }
          },
          "required": [
            "kind",
            "id"
          ]
        }
      ]
    },
    "ORow": {
      "description": "The 3 am question for one seam: which signal leads back to it, where, and who is woken.",
      "type": "object",
      "properties": {
        "breaks_like": {
          "type": [
            "string",
            "null"
          ]
        },
        "owner": {
          "description": "Node id of the side that owns the fix.",
          "type": "string"
        },
        "panel": {
          "description": "Dashboard panel the signal appears on.",
          "type": "string"
        },
        "seam": {
          "type": "string"
        },
        "signal": {
          "description": "Span, metric or log line, with the `rubato.*` attributes it carries.",
          "type": "string"
        }
      },
      "required": [
        "seam",
        "signal",
        "panel",
        "owner"
      ]
    },
    "PartStatus": {
      "type": "string",
      "enum": [
        "affected",
        "new",
        "quiet"
      ]
    },
    "Plan": {
      "type": "object",
      "properties": {
        "affected_parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AffectedPart"
          }
        },
        "assumed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Assumption"
          }
        },
        "attempt_limit": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "flows": {
          "description": "What the plan will send across seams, from its `## Flows` table (ADR 0021). Optional.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlanFlow"
          }
        },
        "git_ref": {
          "description": "Git ref the plan was read from (branch name or commit sha).",
          "type": [
            "string",
            "null"
          ]
        },
        "issue": {
          "$ref": "#/$defs/IssueRef"
        },
        "o_rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ORow"
          }
        },
        "path": {
          "description": "Path of the plan file inside the repository.",
          "type": "string"
        },
        "spend_cap_usd": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "issue",
        "path",
        "affected_parts"
      ]
    },
    "PlanFlow": {
      "description": "One row of the plan's Flows table: something the change sends from one part to another over\na seam. The seam must join the two parts.",
      "type": "object",
      "properties": {
        "carries": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/FlowKind"
        },
        "seam": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      },
      "required": [
        "from",
        "to",
        "seam",
        "kind",
        "carries"
      ]
    },
    "Progress": {
      "description": "Derived progress of one issue, with the time of the newest signal behind it.",
      "type": "object",
      "properties": {
        "issue": {
          "$ref": "#/$defs/IssueRef"
        },
        "last_seen": {
          "type": "string",
          "format": "date-time"
        },
        "pinned_to": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MapRef"
          }
        },
        "reason": {
          "description": "One line on why, for *Blocked* and *Unknown*.",
          "type": [
            "string",
            "null"
          ]
        },
        "session_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "state": {
          "$ref": "#/$defs/ProgressState"
        }
      },
      "required": [
        "issue",
        "state",
        "last_seen"
      ]
    },
    "ProgressState": {
      "oneOf": [
        {
          "description": "Issue exists and is pinned to the map.",
          "type": "string",
          "const": "planned"
        },
        {
          "description": "Session launched for the issue.",
          "type": "string",
          "const": "started"
        },
        {
          "description": "Session working, no plan file yet.",
          "type": "string",
          "const": "designing"
        },
        {
          "description": "Plan file on the branch; affected nodes lit.",
          "type": "string",
          "const": "designed"
        },
        {
          "description": "Session working after the plan.",
          "type": "string",
          "const": "building"
        },
        {
          "description": "Session blocked (hook) or a cap hit.",
          "type": "string",
          "const": "blocked"
        },
        {
          "description": "PR open, checks green.",
          "type": "string",
          "const": "in_review"
        },
        {
          "description": "Merged.",
          "type": "string",
          "const": "done"
        },
        {
          "description": "The signal is not flowing. Trust check first.",
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "PullRequestState": {
      "description": "The pull request for an issue branch.",
      "type": "object",
      "properties": {
        "branch": {
          "type": "string"
        },
        "checks": {
          "$ref": "#/$defs/ChecksStatus"
        },
        "draft": {
          "type": "boolean"
        },
        "merged_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "number": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "open": {
          "type": "boolean"
        },
        "repo": {
          "type": "string"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "repo",
        "number",
        "branch",
        "open",
        "draft",
        "checks",
        "updated_at",
        "url"
      ]
    },
    "SessionState": {
      "description": "One session as the companion sees it. Identity comes from the branch (ADR 0006).",
      "type": "object",
      "properties": {
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "companion_id": {
          "type": "string",
          "format": "uuid"
        },
        "cwd": {
          "type": "string"
        },
        "issue": {
          "description": "Resolved from the branch, or from the launch when the branch does not follow the convention.",
          "anyOf": [
            {
              "$ref": "#/$defs/IssueRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_seen": {
          "type": "string",
          "format": "date-time"
        },
        "repo": {
          "description": "`owner/name` from `origin`.",
          "type": [
            "string",
            "null"
          ]
        },
        "session_id": {
          "description": "Claude Code session id, when known.",
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/StateSource"
        },
        "spend_usd": {
          "description": "Spend so far, summed from the transcript (A11).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "status": {
          "$ref": "#/$defs/SessionStatus"
        },
        "tmux": {
          "anyOf": [
            {
              "$ref": "#/$defs/TmuxLocation"
            },
            {
              "type": "null"
            }
          ]
        },
        "user": {
          "description": "GitHub login of the paired user.",
          "type": "string"
        },
        "worktree": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "companion_id",
        "user",
        "cwd",
        "status",
        "source",
        "last_seen"
      ]
    },
    "SessionStatus": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "working",
            "idle",
            "blocked",
            "ended"
          ]
        },
        {
          "description": "No trustworthy signal. Never rendered as working.",
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "StateSource": {
      "description": "Where a status came from. Anything not hook-derived is rendered *unknown* (A10).",
      "oneOf": [
        {
          "description": "A Claude Code hook forwarded by the companion.",
          "type": "string",
          "const": "hook"
        },
        {
          "description": "tmux-ide state with hook authority (`since` set).",
          "type": "string",
          "const": "tmux_ide"
        },
        {
          "description": "tmux-ide state from screen matching. Not trusted.",
          "type": "string",
          "const": "scraped"
        },
        {
          "description": "The companion just launched it; no event yet.",
          "type": "string",
          "const": "launch"
        }
      ]
    },
    "TmuxLocation": {
      "type": "object",
      "properties": {
        "pane": {
          "description": "tmux pane id such as `%12`.",
          "type": [
            "string",
            "null"
          ]
        },
        "session": {
          "type": "string"
        },
        "socket": {
          "type": [
            "string",
            "null"
          ]
        },
        "window": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "session"
      ]
    }
  }
}
