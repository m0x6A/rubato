{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VoiceTokenRequest",
  "description": "Which room's voice channel to join (`POST` `routes::VOICE_TOKEN`).",
  "type": "object",
  "properties": {
    "branch": {
      "type": "string"
    },
    "number": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "repo": {
      "type": "string"
    }
  },
  "required": [
    "repo",
    "number",
    "branch"
  ]
}
