{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ImportRequest",
  "description": "Import a plan written outside Rubato (ADR 0058): the plan on `branch` of the issue.",
  "type": "object",
  "properties": {
    "branch": {
      "type": "string"
    },
    "number": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "repo": {
      "type": "string"
    }
  },
  "required": [
    "repo",
    "number",
    "branch"
  ]
}
