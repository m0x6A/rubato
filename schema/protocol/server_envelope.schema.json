{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ServerEnvelope",
  "type": "object",
  "properties": {
    "message": {
      "$ref": "#/$defs/ServerMessage"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "seq": {
      "description": "Monotonic per pairing.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    }
  },
  "required": [
    "seq",
    "sent_at",
    "message"
  ],
  "$defs": {
    "IssueRef": {
      "description": "A GitHub issue, addressed as `owner/name#number`.",
      "type": "object",
      "properties": {
        "number": {
          "description": "Issue number within the repository.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "repo": {
          "description": "Repository in `owner/name` form.",
          "type": "string"
        }
      },
      "required": [
        "repo",
        "number"
      ]
    },
    "LaunchCommand": {
      "description": "Server → companion: start a session. Addressed to exactly one pairing; the companion refuses\nany command whose `user` is not its paired user.",
      "type": "object",
      "properties": {
        "attempt": {
          "description": "Which attempt this is, 1-based.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "attempt_limit": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "base_ref": {
          "description": "Ref to branch from, such as `origin/main`.",
          "type": "string"
        },
        "branch": {
          "description": "`issue/<n>-<slug>`.",
          "type": "string"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "issue": {
          "$ref": "#/$defs/IssueRef"
        },
        "map_version": {
          "description": "Git sha of the map the server resolved pins against.",
          "type": [
            "string",
            "null"
          ]
        },
        "node_ids": {
          "description": "Map node ids the issue is pinned to.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "otel_resource": {
          "description": "OTel resource attributes for the session (`rubato.repo`, `rubato.issue`, ...).",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "prompt": {
          "description": "Initial prompt for the session.",
          "type": "string"
        },
        "repo_url": {
          "description": "Clone URL of the repository.",
          "type": "string"
        },
        "session_id": {
          "description": "Claude Code `--session-id` the companion must use, so `session_id → issue` is known up front.",
          "type": "string",
          "format": "uuid"
        },
        "spend_cap_usd": {
          "type": "number",
          "format": "double"
        },
        "user": {
          "description": "GitHub login the command is addressed to.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "user",
        "issue",
        "repo_url",
        "branch",
        "base_ref",
        "spend_cap_usd",
        "attempt_limit",
        "attempt",
        "session_id",
        "prompt"
      ]
    },
    "Limits": {
      "type": "object",
      "properties": {
        "companion_silent_secs": {
          "description": "A companion silent for longer than this fires `CompanionSilent`.",
          "type": "integer",
          "format": "uint64",
          "default": 600,
          "minimum": 0
        },
        "github_poll_interval_secs": {
          "description": "How often the server polls GitHub for PRs, checks and decision comments per live issue.",
          "type": "integer",
          "format": "uint64",
          "default": 60,
          "minimum": 0
        },
        "heartbeat_interval_secs": {
          "description": "Companion heartbeat interval.",
          "type": "integer",
          "format": "uint64",
          "default": 30,
          "minimum": 0
        },
        "plan_poll_interval_secs": {
          "description": "How often the server looks for a plan file on a live branch.",
          "type": "integer",
          "format": "uint64",
          "default": 60,
          "minimum": 0
        },
        "session_stale_secs": {
          "description": "A *working* session with no hook event for longer than this renders *unknown*.",
          "type": "integer",
          "format": "uint64",
          "default": 120,
          "minimum": 0
        },
        "team_poll_interval_secs": {
          "description": "Reconciliation poll of `tmux-ide team --json`.",
          "type": "integer",
          "format": "uint64",
          "default": 30,
          "minimum": 0
        }
      }
    },
    "ServerMessage": {
      "description": "Server → companion.",
      "oneOf": [
        {
          "description": "Answer to `Hello`.",
          "type": "object",
          "properties": {
            "last_seen_companion_seq": {
              "description": "Last companion sequence the server has; the companion replays newer events.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "limits": {
              "$ref": "#/$defs/Limits"
            },
            "protocol_version": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "server_version": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "welcome"
            }
          },
          "required": [
            "type",
            "server_version",
            "protocol_version",
            "last_seen_companion_seq",
            "limits"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "launch"
            }
          },
          "$ref": "#/$defs/LaunchCommand",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "seq": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "ack"
            }
          },
          "required": [
            "type",
            "seq"
          ]
        },
        {
          "description": "The connection will be closed. `code` is stable; `message` is for humans.",
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "error"
            }
          },
          "required": [
            "type",
            "code",
            "message"
          ]
        }
      ]
    }
  }
}
