{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MapRef",
  "description": "A reference into the system map: a node or a seam. Ids come from `system-map.yml` (ADR 0007).",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "node"
        }
      },
      "required": [
        "kind",
        "id"
      ]
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "seam"
        }
      },
      "required": [
        "kind",
        "id"
      ]
    }
  ]
}
