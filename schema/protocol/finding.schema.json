{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Finding",
  "description": "Map versus territory, and plans that disagree with the map. Shown, never suppressed.",
  "oneOf": [
    {
      "description": "A plan names ids the map does not declare.",
      "type": "object",
      "properties": {
        "ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "issue": {
          "$ref": "#/$defs/IssueRef"
        },
        "kind": {
          "type": "string",
          "const": "unknown_ids"
        }
      },
      "required": [
        "kind",
        "issue",
        "ids"
      ]
    },
    {
      "description": "Two or more open plans touch the same seam.",
      "type": "object",
      "properties": {
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IssueRef"
          }
        },
        "kind": {
          "type": "string",
          "const": "seam_collision"
        },
        "seam": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "seam",
        "issues"
      ]
    },
    {
      "description": "A plan file exists but does not parse.",
      "type": "object",
      "properties": {
        "error": {
          "type": "string"
        },
        "issue": {
          "$ref": "#/$defs/IssueRef"
        },
        "kind": {
          "type": "string",
          "const": "plan_parse_error"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "issue",
        "path",
        "error"
      ]
    },
    {
      "description": "A session was launched against a different map version than the server holds.",
      "type": "object",
      "properties": {
        "current": {
          "type": "string"
        },
        "issue": {
          "$ref": "#/$defs/IssueRef"
        },
        "kind": {
          "type": "string",
          "const": "map_version_mismatch"
        },
        "launched_with": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "issue",
        "launched_with",
        "current"
      ]
    },
    {
      "description": "The GitHub App installation does not cover a repo the map or a tracked issue names, so\nits branches, plans and pull requests cannot be read (ADR 0022).",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "repo_not_covered"
        },
        "repo": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "repo"
      ]
    },
    {
      "description": "A plan's flow names a seam that does not join the flow's two parts (ADR 0021).",
      "type": "object",
      "properties": {
        "from": {
          "type": "string"
        },
        "issue": {
          "$ref": "#/$defs/IssueRef"
        },
        "kind": {
          "type": "string",
          "const": "flow_off_seam"
        },
        "seam": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "issue",
        "seam",
        "from",
        "to"
      ]
    },
    {
      "description": "The plan was approved, then changed: the approval names an earlier version (ADR 0027).",
      "type": "object",
      "properties": {
        "approved_sha": {
          "type": "string"
        },
        "current_sha": {
          "type": "string"
        },
        "issue": {
          "$ref": "#/$defs/IssueRef"
        },
        "kind": {
          "type": "string",
          "const": "approval_stale"
        }
      },
      "required": [
        "kind",
        "issue",
        "approved_sha",
        "current_sha"
      ]
    },
    {
      "description": "An approval names the current plan, but the plan does not fit the map, so it does not\ncount (ADR 0029).",
      "type": "object",
      "properties": {
        "issue": {
          "$ref": "#/$defs/IssueRef"
        },
        "kind": {
          "type": "string",
          "const": "approved_without_fit"
        }
      },
      "required": [
        "kind",
        "issue"
      ]
    },
    {
      "description": "A live session Rubato cannot tie to an issue: its branch is not `issue/<n>-…`, or its\nrepo is unknown.",
      "type": "object",
      "properties": {
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "companion": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "type": "string",
          "const": "unattributed_session"
        },
        "repo": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "companion"
      ]
    },
    {
      "description": "Map versus territory (ADR 0039): a declared seam with no calls in the window of a fresh\nreport, though both its parts show traffic elsewhere in it.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "seam_quiet"
        },
        "seam": {
          "type": "string"
        },
        "window_secs": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "kind",
        "seam",
        "window_secs"
      ]
    },
    {
      "description": "Map versus territory (ADR 0039): calls between two parts no seam joins, from a fresh\nreport. `from` calls `to`.",
      "type": "object",
      "properties": {
        "calls": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "from": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "undeclared_traffic"
        },
        "to": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "from",
        "to",
        "calls"
      ]
    }
  ],
  "$defs": {
    "IssueRef": {
      "description": "A GitHub issue, addressed as `owner/name#number`.",
      "type": "object",
      "properties": {
        "number": {
          "description": "Issue number within the repository.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "repo": {
          "description": "Repository in `owner/name` form.",
          "type": "string"
        }
      },
      "required": [
        "repo",
        "number"
      ]
    }
  }
}
