{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PairStartResponse",
  "type": "object",
  "properties": {
    "device_code": {
      "description": "Opaque; the companion polls with it.",
      "type": "string"
    },
    "expires_in_secs": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "interval_secs": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "user_code": {
      "description": "Shown to the human, who enters it in the web view while logged in.",
      "type": "string"
    },
    "verification_url": {
      "type": "string"
    }
  },
  "required": [
    "device_code",
    "user_code",
    "verification_url",
    "interval_secs",
    "expires_in_secs"
  ]
}
