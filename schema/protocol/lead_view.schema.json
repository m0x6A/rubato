{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LeadView",
  "description": "A lead and its live workers, for the web (`Overview.leads`).",
  "type": "object",
  "properties": {
    "launch_id": {
      "type": "string",
      "format": "uuid"
    },
    "owner": {
      "type": "string"
    },
    "workers": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    }
  },
  "required": [
    "launch_id",
    "owner",
    "workers"
  ]
}
