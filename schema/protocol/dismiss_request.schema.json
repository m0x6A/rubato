{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DismissRequest",
  "description": "Dismiss an agent (`DELETE` `routes::ROOM_AGENTS`): its owner, or whoever called it in.",
  "type": "object",
  "properties": {
    "branch": {
      "type": "string"
    },
    "handle": {
      "type": "string"
    },
    "number": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "repo": {
      "type": "string"
    }
  },
  "required": [
    "repo",
    "number",
    "branch",
    "handle"
  ]
}
