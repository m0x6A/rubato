{
  "name": "rubato",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "plan-check": "node --experimental-strip-types actions/plan-check/src/cli.ts",
    "observability:check": "node --experimental-strip-types observability/check.ts",
    "observability:test": "node --experimental-strip-types --test observability/check.test.ts observability/publish.test.ts",
    "observability:publish": "node --experimental-strip-types observability/publish.ts",
    "e2e": "pnpm --filter @rubato/e2e e2e"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "@types/node": "^24.0.0",
    "yaml": "^2.8.0"
  },
  "type": "module"
}
